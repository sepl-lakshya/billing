# Frontend build config — DEMO (demobilling.surbhi.net)
# Used by: vite build --mode demo
# Committed: NON-SECRET values only (Entra IDs are public, not secrets).

# Same-origin: the Node backend serves this SPA, so leave the API URL empty
# and calls go to /api on the same host (nginx -> Node).
VITE_API_URL=

# --- Authentication --------------------------------------------------------
# central = SEPL suite single sign-on via CENTRAL_LOGIN_ORIGIN (recommended)
# none    = open access (matches backend AUTH_MODE=none)
# entra   = standalone Microsoft Entra ID sign-in
VITE_AUTH_MODE=central
# Central login origin + Home target — env-specific, NEVER hardcoded in code.
VITE_CENTRAL_LOGIN_ORIGIN=https://demo.surbhi.net
VITE_HOME_URL=https://demo.surbhi.net/dashboard
# Only when VITE_AUTH_MODE=entra (public SPA IDs; per-VM override in
# frontend/.env.demo.local, git-ignored):
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=
