# Frontend build config — PRODUCTION (billing.surbhi.net)
# Used by: vite build --mode production  (the default build mode)
# Committed: NON-SECRET values only (Entra IDs are public, not secrets).

# Same-origin: the Node backend serves this SPA, so leave the API URL empty
# and calls go to /api on the same host (nginx -> Node).
VITE_API_URL=

# --- Authentication --------------------------------------------------------
# none  = open access (matches backend AUTH_MODE=none)
# entra = Microsoft Entra ID sign-in (set backend AUTH_MODE=entra too)
VITE_AUTH_MODE=none
# Fill these to turn Entra ID ON (then set VITE_AUTH_MODE=entra + redeploy).
# For a per-VM override without editing this committed file, use
# frontend/.env.production.local (git-ignored).
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# API scope exposed by the backend app registration,
# e.g. api://<api-client-id>/access_as_user
VITE_ENTRA_API_SCOPE=
