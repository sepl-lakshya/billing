# Frontend environment reference.
# Deployed builds use `.env.demo` / `.env.production` selected by the Vite
# build mode:  vite build --mode demo   |   vite build           (=production)
# Per-VM overrides go in `.env.<mode>.local` (git-ignored).

# Absolute API base URL. Leave EMPTY for same-origin (Node serves this SPA in
# production; the Vite dev proxy forwards /api in development).
VITE_API_URL=
# Dev-only: where the Vite dev proxy forwards /api and /uploads.
VITE_API_TARGET=http://localhost:4000

# --- Authentication ---------------------------------------------------------
# central = SEPL suite single sign-on (shared login at VITE_CENTRAL_LOGIN_ORIGIN)
# none    = open access (matches backend AUTH_MODE=none)
# entra   = standalone Microsoft Entra ID sign-in (requires backend AUTH_MODE=entra)
VITE_AUTH_MODE=none
# Required when VITE_AUTH_MODE=central (env-specific, NEVER hardcoded in code):
VITE_CENTRAL_LOGIN_ORIGIN=
# Home button target (defaults to <central origin>/dashboard):
VITE_HOME_URL=
# Required when VITE_AUTH_MODE=entra (SPA app registration — public, not secret):
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# API scope exposed by the backend app registration,
# e.g. api://<api-client-id>/access_as_user
VITE_ENTRA_API_SCOPE=
