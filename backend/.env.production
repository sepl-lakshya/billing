# ============================================================================
# Billing API — PRODUCTION environment  (billing.surbhi.net)
# Committed template: NON-SECRET values only.
# Per-VM secrets (DB password, Entra IDs) go in `backend/.env.local`
# (git-ignored) or as real environment variables — those always win.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
APP_ENV=production           # selects this file + production domain/URLs
PORT=4000

# --- Database (fill real creds in .env.local on the VM) --------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=billing
DB_POOL_SIZE=20

# --- HTTP / security -------------------------------------------------------
CORS_ORIGIN=https://billing.surbhi.net
UPLOAD_DIR=uploads
FRONTEND_DIST=../frontend/dist
MAX_UPLOAD_MB=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Logging ---------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=warn

# --- Authentication --------------------------------------------------------
# Start with `none`. To enable Microsoft Entra ID sign-in later, set
# AUTH_MODE=entra and put ENTRA_TENANT_ID / ENTRA_CLIENT_ID in .env.local,
# then redeploy. (These IDs are public, not secrets.)
AUTH_MODE=none
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ADMIN_ROLE=Billing.Admin

SYSTEM_USER_ID=1
