# ============================================================================
# Billing API — environment configuration reference
#
# Deployed VMs use the committed templates `.env.demo` / `.env.production`
# (selected by APP_ENV). Put per-VM SECRETS (DB password, Entra IDs) in
# `backend/.env.local` (git-ignored) — real env vars & .env.local always win.
#
# Load order (first value found wins per variable):
#   1. real environment variables (PM2 / platform)
#   2. .env.local            (per-VM secrets — git-ignored)
#   3. .env.<APP_ENV>        (.env.demo | .env.production — committed)
#   4. .env.<NODE_ENV>       (.env.development | .env.production)
#   5. .env                  (shared defaults)
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development            # development | production
APP_ENV=                        # demo | production (defaults to NODE_ENV)
PORT=4000

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=billing
DB_POOL_SIZE=10

# --- HTTP / security --------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173
# Folder (relative to backend/) where uploaded attachments are stored.
UPLOAD_DIR=uploads
# Built frontend path to enable single-process deployment.
FRONTEND_DIST=../frontend/dist
MAX_UPLOAD_MB=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300              # requests per window per IP (prod default)

# --- Logging ----------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=debug                 # debug | info | warn | error

# --- Authentication / access control ----------------------------------------
# none    = open access (local/dev). Every request acts as the system user.
# central = SEPL suite single sign-on (shared spm_token cookie). Access is
#           governed by the central user_permissions table.
# entra   = Microsoft Entra ID (Azure AD) bearer-token authentication.
AUTH_MODE=none

# Required when AUTH_MODE=central:
#   CENTRAL_LOGIN_ORIGIN = the suite's central login origin
#     (e.g. https://demo.surbhi.net or https://apps.surbhi.net).
#   AUTH_DB_NAME         = central DB (same MySQL server) with users +
#     user_permissions (default: easyreminder).
#   JWT_SECRET           = shared signing secret for the spm_token
#     (SECRET — put it in .env.local).
CENTRAL_LOGIN_ORIGIN=
AUTH_DB_NAME=easyreminder

# Required when AUTH_MODE=entra:
#   1. Register an API app in Entra ID (expose an API, define app roles).
#   2. Define an app role e.g. "Billing.Admin" and assign users/groups to it.
#   3. Frontend acquires tokens for this API (scope api://<client-id>/...).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ADMIN_ROLE=Billing.Admin

# Identity used to attribute records when AUTH_MODE=none.
SYSTEM_USER_ID=1
