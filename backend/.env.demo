# ============================================================================
# Billing API — DEMO / testing environment  (demobilling.surbhi.net)
# Committed template: NON-SECRET values only.
# Per-VM secrets (DB password, Entra IDs) go in `backend/.env.local`
# (git-ignored) or as real environment variables — those always win.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production          # production-grade hardening on the demo VM too
APP_ENV=demo                 # selects this file + demo domain/URLs
PORT=4000

# --- Database (fill real creds in .env.local on the VM) --------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=billing
DB_POOL_SIZE=10

# --- HTTP / security -------------------------------------------------------
CORS_ORIGIN=https://demobilling.surbhi.net
UPLOAD_DIR=uploads
FRONTEND_DIST=../frontend/dist
MAX_UPLOAD_MB=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Logging ---------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=info

# --- Authentication --------------------------------------------------------
# `central` = SEPL suite single sign-on: users authenticate once at
# CENTRAL_LOGIN_ORIGIN (Microsoft) and this portal trusts the shared
# `spm_token` cookie on *.surbhi.net. Access is governed by the central
# can_(view|create|delete)_billing_portal permissions. Nothing is hardcoded.
AUTH_MODE=central
CENTRAL_LOGIN_ORIGIN=https://demo.surbhi.net
# Central portal DB (same MySQL server) holding users + user_permissions.
AUTH_DB_NAME=easyreminder
# The shared JWT signing secret is a SECRET -> set JWT_SECRET in .env.local.

# Alternative: standalone Microsoft Entra ID sign-in (AUTH_MODE=entra) — fill
# these (public IDs) here or in .env.local, then redeploy.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ADMIN_ROLE=Billing.Admin

SYSTEM_USER_ID=1
